  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/react": "~19.2.2",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "concurrently": "^9.0.0",
    "vitest": "^5.0.5",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.64.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "docs:validate": "node scripts/docs/cli.mjs validate",
    "docs:test": "node --test scripts/docs/*.test.mjs",
    "knowledge:build": "node scripts/docs/cli.mjs build",
    "knowledge:check": "node scripts/docs/cli.mjs check",
    "knowledge:plan": "node scripts/docs/cli.mjs plan",
    "code:inventory": "node scripts/code/cli.mjs inventory",
    "code:check": "node scripts/code/cli.mjs check",
    "code:test": "node --test scripts/code/*.test.mjs",
    "knowledge:plan-code": "node scripts/code/cli.mjs plan",
    "knowledge:migrate": "node scripts/rag/cli.mjs migrate",
    "knowledge:ingest": "node scripts/rag/local-cli.mjs ingest",
    "knowledge:ask": "node scripts/rag/local-cli.mjs ask",
    "knowledge:search": "node scripts/rag/local-cli.mjs search",
    "knowledge:health": "node scripts/rag/local-cli.mjs health",
    "knowledge:evaluate": "node scripts/rag/cli.mjs evaluate",
    "rag:test": "node --env-file-if-exists=.env --test scripts/rag/*.test.mjs",
    "test": "npm run docs:test && npm run code:test && npm run rag:test",
    "knowledge:db": "node scripts/rag/local-db.mjs",
    "knowledge:api:ingest": "node scripts/rag/cli.mjs ingest",
    "knowledge:api:search": "node scripts/rag/cli.mjs search",
    "knowledge:api:ask": "node scripts/rag/cli.mjs ask",
    "knowledge:api:health": "node scripts/rag/cli.mjs health",
    "knowledge:context": "node scripts/rag/local-cli.mjs context",
    "personal:setup": "tsx scripts/prepare-personal-db.ts && prisma generate && prisma migrate deploy && tsx server/seed.ts",
    "personal:api": "tsx watch server/index.ts",
    "personal:dev": "concurrently -k \"npm run personal:api\" \"expo start --web --port 8081\"",
    "personal:build": "expo export --platform web",
    "personal:start": "tsx server/index.ts",
    "personal:test": "vitest run",
    "personal:e2e": "playwright test",
    "personal:import": "tsx server/import-compasso.ts",
    "personal:typecheck": "tsc --noEmit -p tsconfig.server.json",
    "personal:purge-enrollments": "tsx server/purge-enrollments.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
