NODE_ENV=production
PERSONAL_ENROLLMENT_ORIGIN=https://tapago.coletivopindorama.com.br
PERSONAL_APP_ORIGINS=https://tapago.coletivopindorama.com.br
COOKIE_SECURE=true
PERSONAL_API_HOST=0.0.0.0
PERSONAL_ENROLLMENT_RETENTION_DAYS=90
# Preencher no painel com arquivo SQLite em diretório privado persistente fora da release.
# Formato: file:/caminho/absoluto/persistente/tapago.db
PERSONAL_DATABASE_URL=
# Preencher no gerenciador de segredos. Nunca versionar o valor real.
# Para preservar fichas existentes, importar a mesma chave local com segurança.
PERSONAL_ENROLLMENT_KEY=
# Configurar somente após confirmar IPs/sub-redes do proxy da hospedagem.
# PERSONAL_TRUST_PROXY=loopback
# PORT é fornecida pelo provedor. Não fixe a porta local 3003 no painel.
# EXPO_PUBLIC_PERSONAL_API_URL deve ficar ausente: web usa a mesma origem HTTPS.
