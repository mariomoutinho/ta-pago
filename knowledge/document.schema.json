{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadados documentais Tá Pago",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ta-pago\\.[a-zA-Z0-9.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "proposed",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "language": {
      "type": "string",
      "enum": [
        "pt-BR"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexable": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "updated_at",
    "language",
    "tags",
    "indexable",
    "sources"
  ]
}
