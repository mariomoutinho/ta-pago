{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadados documentais Tá Pago",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ta-pago\\.[a-zA-Z0-9.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "proposed",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "language": {
      "type": "string",
      "enum": [
        "pt-BR"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "indexable": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\w./-]+$"
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "authority": {
      "type": "string",
      "enum": [
        "code",
        "requirement",
        "architecture",
        "decision",
        "policy",
        "proposal",
        "external",
        "product"
      ]
    },
    "audience": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "developer",
          "ai_agent",
          "teacher",
          "student",
          "product",
          "operations",
          "reviewer"
        ]
      },
      "minItems": 1
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ta-pago\\.[a-zA-Z0-9.-]+$"
      }
    },
    "related_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ta-pago\\.[a-zA-Z0-9.-]+$"
      }
    },
    "framework_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "product",
        "requirements",
        "architecture",
        "navigation",
        "ui",
        "components",
        "hooks",
        "routing",
        "development",
        "operations",
        "ai",
        "rag",
        "testing",
        "fitness",
        "social",
        "workouts",
        "running",
        "teacher-student"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "owner",
    "updated_at",
    "language",
    "tags",
    "indexable",
    "sources",
    "repository",
    "branch",
    "commit_sha",
    "version",
    "authority",
    "audience",
    "sensitivity",
    "supersedes",
    "related_documents",
    "framework_version",
    "domain"
  ]
}
