generator client {
  provider = "prisma-client"
  output = "../server/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  role String @default("personal")
  exercises Exercise[]
  students Student[] @relation("PersonalStudents")
  profiles Student[] @relation("StudentAccount")
  programs Program[]
  passwordHash String
  sessions Session[]
  enrollmentLink EnrollmentLink?
  enrollmentRequests EnrollmentRequest[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  expiresAt DateTime
}
model Student {
  personalId String
  personal User @relation("PersonalStudents",fields:[personalId],references:[id],onDelete:Restrict)
  accountId String?
  account User? @relation("StudentAccount",fields:[accountId],references:[id],onDelete:SetNull)
  linkStatus String @default("unlinked")
  workoutPlans WorkoutPlan[]
  invitations Invitation[]
  enrollmentRequest EnrollmentRequest?
  id String @id @default(cuid())
  name String
  birthDate String?
  phone String @default("")
  email String @default("")
  sex String @default("")
  startDate String
  status String @default("ativo")
  mainGoal String
  secondaryGoals String @default("")
  experience String @default("")
  weeklyFrequency Int @default(3)
  availability String @default("")
  notes String @default("")
  injuries String @default("")
  limitations String @default("")
  surgeries String @default("")
  conditions String @default("")
  medications String @default("")
  restrictions String @default("")
  emergencyContact String @default("")
  nextEvaluationDate String?
  programId String?
  program Program? @relation(fields:[programId],references:[id],onDelete:SetNull)
  evaluations Evaluation[]
  records TrackingRecord[]
  history HistoryEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Program {
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
  id String @id @default(cuid())
  name String
  description String
  weeklyFrequency Int
  cycleDays Int @default(30)
  sessions String
  students Student[]
  evaluations Evaluation[]
  createdAt DateTime @default(now())
}
model EvaluationTemplate {
  ownerId String @default("system")
  id String @id @default(cuid())
  name String
  version Int
  cycleDays Int @default(30)
  questions EvaluationQuestion[]
  evaluations Evaluation[]
  createdAt DateTime @default(now())
  @@unique([name,version,ownerId])
}
model EvaluationQuestion {
  id String @id @default(cuid())
  templateId String
  template EvaluationTemplate @relation(fields:[templateId],references:[id],onDelete:Cascade)
  position Int
  dimension String
  text String
  type String
  required Boolean @default(true)
  min Float?
  max Float?
  options EvaluationOption[]
  answers EvaluationAnswer[]
  @@unique([templateId,position])
}
model EvaluationOption {
  id String @id @default(cuid())
  questionId String
  question EvaluationQuestion @relation(fields:[questionId],references:[id],onDelete:Cascade)
  position Int
  label String
}
model Evaluation {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  templateId String
  template EvaluationTemplate @relation(fields:[templateId],references:[id],onDelete:Restrict)
  programId String?
  program Program? @relation(fields:[programId],references:[id],onDelete:SetNull)
  programSnapshot String @default("")
  date String
  cycle Int
  evaluator String
  status String @default("rascunho")
  notes String @default("")
  conclusion String @default("")
  actionPlan String @default("")
  answers EvaluationAnswer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId,date])
}
model EvaluationAnswer {
  id String @id @default(cuid())
  evaluationId String
  evaluation Evaluation @relation(fields:[evaluationId],references:[id],onDelete:Cascade)
  questionId String
  question EvaluationQuestion @relation(fields:[questionId],references:[id],onDelete:Restrict)
  value String
  @@unique([evaluationId,questionId])
}
model TrackingRecord {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  kind String
  date String
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId,kind,date])
}
model HistoryEntry {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  action String
  detail Json
  createdAt DateTime @default(now())
  @@index([studentId,createdAt])
}

model Invitation {
  id String @id @default(cuid())
  tokenHash String @unique
  studentId String
  student Student @relation(fields:[studentId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}

model EnrollmentLink {
  id String @id @default(cuid())
  personalId String @unique
  personal User @relation(fields:[personalId],references:[id],onDelete:Cascade)
  token String @unique
  active Boolean @default(true)
  publicName String
  contact String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  challenges EnrollmentChallenge[]
}
model EnrollmentChallenge {
  id String @id
  linkId String
  link EnrollmentLink @relation(fields:[linkId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}
model EnrollmentRequest {
  id String @id @default(cuid())
  personalId String
  personal User @relation(fields:[personalId],references:[id],onDelete:Restrict)
  emailHash String
  payload String
  healthPayload String?
  status String @default("pending")
  studentId String? @unique
  student Student? @relation(fields:[studentId],references:[id],onDelete:Cascade)
  policyVersion String
  consentAt DateTime
  healthConsentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events EnrollmentEvent[]
  @@unique([personalId,emailHash])
  @@index([personalId,status,createdAt])
}
model EnrollmentEvent {
  id String @id @default(cuid())
  requestId String
  request EnrollmentRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
  status String
  createdAt DateTime @default(now())
}

// A atribuição usa o vínculo Student existente; não cria outro cadastro de aluno.
model WorkoutPlan {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  title String
  objective String
  difficulty String
  startsAt String
  endsAt String?
  instructions String @default("")
  status String @default("rascunho")
  publishedAt DateTime?
  revision Int @default(1)
  workouts Workout[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId,status])
}
model Workout {
  id String @id @default(cuid())
  planId String
  plan WorkoutPlan @relation(fields:[planId], references:[id], onDelete:Cascade)
  name String
  subtitle String @default("")
  instructions String @default("")
  orderIndex Int
  deletedAt DateTime?
  feedbacks WorkoutFeedback[]
  exercises WorkoutExercise[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([planId,orderIndex])
}
model Exercise {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:Restrict)
  name String
  muscleGroup String
  category String
  equipment String @default("")
  description String @default("")
  imageUrl String @default("")
  videoUrl String @default("")
  notes String @default("")
  status String @default("ativo")
  prescriptions WorkoutExercise[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,status])
}
model WorkoutExercise {
  id String @id @default(cuid())
  workoutId String
  workout Workout @relation(fields:[workoutId], references:[id], onDelete:Cascade)
  exerciseId String
  exercise Exercise @relation(fields:[exerciseId], references:[id], onDelete:Restrict)
  orderIndex Int
  sets Int?
  repetitions String @default("")
  load Float?
  durationSeconds Int?
  restSeconds Int?
  rir Float?
  rpe Float?
  cadence String @default("")
  notes String @default("")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workoutId,orderIndex])
}

model WorkoutFeedback {
  id String @id @default(cuid())
  workoutId String
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  requestId String
  comment String
  createdAt DateTime @default(now())
  @@unique([workoutId, requestId])
  @@index([workoutId, createdAt])
}
