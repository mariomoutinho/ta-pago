# Usado apenas pelos scripts Node; nunca prefixar segredos com EXPO_PUBLIC_.
RAG_ENABLED=true
RAG_DB_PASSWORD=
RAG_DB_PORT=5433
# Configure após escolher a senha (URL-encode caracteres especiais).
DATABASE_URL=
OPENAI_API_KEY=
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_LLM_MODEL=gpt-4.1-mini
RAG_TOP_K=8
RAG_RERANK_TOP_K=30
RAG_MAX_CHUNKS=8
RAG_MAX_CONTEXT_TOKENS=12000
RAG_MIN_SCORE=0.15
RAG_RELATION_DEPTH=1
RAG_MAX_RELATED_CHUNKS=5
RAG_BATCH_SIZE=16
RAG_TIMEOUT_MS=60000
RAG_LOGS=true

# Opcional: banco exclusivo de testes, nome terminado em _test.
RAG_TEST_DATABASE_URL=

# Módulo Personal: separado do PostgreSQL/RAG acima. Não contém dados demonstrativos.
PERSONAL_DATABASE_URL=file:./data/tapago.db
PERSONAL_API_PORT=3003
PERSONAL_API_HOST=127.0.0.1
PERSONAL_APP_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:3003,http://localhost:3003
# Para celular físico: URL da API acessível na rede local (sem credenciais).
# EXPO_PUBLIC_PERSONAL_API_URL=http://IP_DO_COMPUTADOR:3003
