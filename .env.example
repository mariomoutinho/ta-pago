# Usado apenas pelos scripts Node; nunca prefixar segredos com EXPO_PUBLIC_.
RAG_ENABLED=true
RAG_DB_PASSWORD=
RAG_DB_PORT=5433
# Configure após escolher a senha (URL-encode caracteres especiais).
DATABASE_URL=
OPENAI_API_KEY=
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_LLM_MODEL=gpt-4.1-mini
RAG_TOP_K=8
RAG_RERANK_TOP_K=30
RAG_MAX_CHUNKS=8
RAG_MAX_CONTEXT_TOKENS=12000
RAG_MIN_SCORE=0.15
RAG_RELATION_DEPTH=1
RAG_MAX_RELATED_CHUNKS=5
RAG_BATCH_SIZE=16
RAG_TIMEOUT_MS=60000
RAG_LOGS=true

# Opcional: banco exclusivo de testes, nome terminado em _test.
RAG_TEST_DATABASE_URL=
