Options -Indexes -MultiViews
DirectoryIndex index.html index.php
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^(?:backend-php|tapago-private|private|src|generated|bin|tests|data|vendor|node_modules)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(?:sql|db|sqlite|env|log|ini|jsonl|bak|zip)$ - [F,L,NC]
# Somente o front controller executa PHP; configuração nunca é pública.
RewriteRule ^(?!api/index\.php$).*\.php$ - [F,L,NC]
RewriteRule ^api(?:/.*)?$ api/index.php [END,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Asset inexistente deve ser 404, nunca HTML com status 200.
RewriteRule ^(?:_expo|assets)(?:/|$) - [R=404,L]
RewriteRule ^ index.html [END]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
<FilesMatch "^(index\.html|manifest\.webmanifest)$">
Header set Cache-Control "no-store"
</FilesMatch>
</IfModule>
