{
  "expo": {
    "name": "Tá Pago Personal",
    "slug": "ta-pago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logotapago.png",
    "scheme": "tapago",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./logotapago.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./logotapago.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./logotapago.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./logotapago.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
